Windows Registry Editor Version 5.00

; Example only. Review and merge with your existing Chrome policies.
; Group Policy name: Block access to a list of URLs (URLBlocklist).

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\URLBlocklist]
"1"="youtube.com"
"2"="[*.]youtube.com"
"3"="youtu.be"
"4"="[*.]youtube-nocookie.com"
